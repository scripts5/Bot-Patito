# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
OWNER_ID=your_owner_id_here

# Environment
NODE_ENV=development

# Database
DB_PATH=./data

# Logging
LOG_LEVEL=info

# API Keys (optional)
XAI_API_KEY=your_xai_api_key_here

# Features
DEBUG=false
